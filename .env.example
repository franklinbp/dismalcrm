# IDENTIDAD DE LA INSTANCIA
COMPOSE_PROJECT_NAME=dismalcrm
PUBLIC_DOMAIN=dismal.vip
APP_COUNTRY=EC
WHATSAPP_ALLOWED_COUNTRY_CODE=593,51
WHATSAPP_MAX_CONNECTIONS=2
BOOTSTRAP_COMPANY_NAME=Dismal
BOOTSTRAP_ADMIN_NAME=Administrador Dismal
BOOTSTRAP_ADMIN_EMAIL=admin@dismal.vip
BOOTSTRAP_ADMIN_PASSWORD=

# MYSQL (use valores secretos diferentes a MaleskinCRM)
MYSQL_ENGINE=mariadb
MYSQL_VERSION=10.6
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=dismalcrm
MYSQL_PORT=
TZ=America/Guayaquil
DB_TIMEZONE=-05:00

# BACKEND
BACKEND_PORT=8081
BACKEND_SERVER_NAME=
BACKEND_URL=https://dismal.vip
PROXY_PORT=443
CHROME_ARGS=--no-sandbox --disable-setuid-sandbox
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECURE=

# META MESSENGER / INSTAGRAM
META_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v13.0

# BOT VISUAL EN PRODUCCION (mantener apagado hasta completar las pruebas)
BOT_RUNTIME_ENABLED=false

# FRONTEND
FRONTEND_PORT=7001
FRONTEND_SSL_PORT=
FRONTEND_SERVER_NAME=dismal.vip
FRONTEND_URL=https://dismal.vip
VITE_BACKEND_URL=/api
VITE_SALES_URL=

# EASYPANEL / TRAEFIK
EASYPANEL_PROXY_NETWORK=easypanel
EASYPANEL_TRAEFIK_SERVICE=easypanel-traefik
EASYPANEL_HTTP_ENTRYPOINT=http
EASYPANEL_HTTPS_ENTRYPOINT=https
EASYPANEL_CERT_RESOLVER=letsencrypt
EASYPANEL_TRAEFIK_CONFIG_DIR=/data/config

# BROWSERLESS
MAX_CONCURRENT_SESSIONS=

# PHPMYADMIN
PMA_PORT=
